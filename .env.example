# ──────────────────────────────────────────────────────────────────────────────
# FIREBASE — Sincronização Compartilhada em Tempo Real
# Obtenha em: Firebase Console → Configurações ⚙️ → Seus aplicativos → Web
# Docs: https://console.firebase.google.com
# ──────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY="COLE_AQUI"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://seu-projeto-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxx"

# ──────────────────────────────────────────────────────────────────────────────
# BRAPI — Cotações e dividendos da B3 (usado pela função /api/invest do Netlify)
# Cadastre no painel do Netlify: Site configuration → Environment variables.
# NÃO use prefixo VITE_: o token fica só no servidor, nunca no navegador.
# Docs: https://brapi.dev/docs
# ──────────────────────────────────────────────────────────────────────────────
BRAPI_TOKEN="COLE_AQUI"

# ──────────────────────────────────────────────────────────────────────────────
# RELATÓRIO DE AÇÕES — função agendada invest-alert (8h, 14h e 20h de Brasília)
# Cadastre no Netlify. Instale o app ntfy no celular e assine o mesmo tópico
# (use um nome difícil de adivinhar: quem souber o tópico lê as mensagens).
# ──────────────────────────────────────────────────────────────────────────────
NTFY_TOPIC="financas-COLE_UM_NOME_SECRETO"
FIREBASE_DATABASE_URL="https://seu-projeto-default-rtdb.firebaseio.com"
SYNC_CODE="SEU_CODIGO_DE_SINCRONIZACAO"
# Opcional: só se as regras do Realtime Database exigirem autenticação.
FIREBASE_DB_SECRET=""
