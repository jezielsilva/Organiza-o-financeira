# ──────────────────────────────────────────────────────────────────────────────
# FIREBASE — Sincronização Compartilhada em Tempo Real
# Obtenha em: Firebase Console → Configurações ⚙️ → Seus aplicativos → Web
# Docs: https://console.firebase.google.com
# ──────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY="COLE_AQUI"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://seu-projeto-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxx"
